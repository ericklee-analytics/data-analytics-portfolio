umn index="25" value="75"/><column index="26" value="129"/><column index="27" value="81"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Overall Churn Rate*">SELECT 
COUNT(*) AS total_customers,
SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS churned_customers,
ROUND(SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS churn_rate_percent
FROM telecom_churn;</sql><sql name="Churn Rate By Contract Type*">SELECT 
Contract,
COUNT(*) AS total_customers,
SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS churned_customers,
ROUND(SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS churn_rate_percent
FROM telecom_churn
GROUP BY Contract
ORDER BY churn_rate_percent DESC;</sql><sql name="Churn By Tenure Group*">SELECT 
Tenure_Group,
COUNT(*) AS total_customers,
SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS churned_customers,
ROUND(SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS churn_rate_percent
FROM telecom_churn
GROUP BY Tenure_Group
ORDER BY churn_rate_percent DESC;</sql><sql name="Revenue Impact*">SELECT 
Churn,
ROUND(AVG(Monthly_Charges),2) AS avg_monthly_charge,
ROUND(AVG(Total_Charges),2) AS avg_total_revenue
FROM telecom_churn
GROUP BY Churn;</sql><sql name="Risk Score Performance*">SELECT 
Risk_Score,
COUNT(*) AS total_customers,
SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS churned_customers,
ROUND(SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS churn_rate_percent
FROM telecom_churn
GROUP BY Risk_Score
ORDER BY Risk_Score;</sql><sql name="High Risk Segments*">SELECT 
Contract,
Tenure_Group,
Risk_Score,
COUNT(*) AS customers,
SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS churned
FROM telecom_churn
GROUP BY Contract, Tenure_Group, Risk_Score
ORDER BY churned DESC
LIMIT 10;</sql><current_tab id="5"/></tab_sql></sqlb_project>
